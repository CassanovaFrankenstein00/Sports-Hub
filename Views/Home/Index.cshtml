@{
    ViewData["Title"] = "Home Page";
}

<div style="background-color:#172554;
            color:white;
            padding:40px;
            border-radius:12px;
            margin-top:20px;">

    <h1 style="font-size:36px;
               font-weight:bold;">
        All Your Teams in One Place
    </h1>

    <p style="font-size:18px;">
        Browse teams, explore leagues, and view standings
        across your favorite sports.
    </p>

    <button type="button"
            style="background-color:#2563eb;
                   color:white;
                   padding:12px 25px;
                   border:none;
                   border-radius:8px;
                   margin-top:15px;">
        Browse Teams
    </button>

</div>

<h2 style="color:#172554;
           margin-top:35px;
           margin-bottom:20px;">
    League Overview
</h2>

<div style="display:flex;
            flex-wrap:wrap;
            gap:20px;
            justify-content:space-between;">

    <div style="background-color:#f1f5f9;
                padding:25px;
                border-radius:10px;
                text-align:center;
                flex:1 1 180px;">

        <h3>NFL</h3>
        <p>Football</p>
        <button type="button">View Teams</button>

    </div>

    <div style="background-color:#f1f5f9;
                padding:25px;
                border-radius:10px;
                text-align:center;
                flex:1 1 180px;">

        <h3>NBA</h3>
        <p>Basketball</p>
        <button type="button">View Teams</button>

    </div>

    <div style="background-color:#f1f5f9;
                padding:25px;
                border-radius:10px;
                text-align:center;
                flex:1 1 180px;">

        <h3>MLB</h3>
        <p>Baseball</p>
        <button type="button">View Teams</button>

    </div>

    <div style="background-color:#f1f5f9;
                padding:25px;
                border-radius:10px;
                text-align:center;
                flex:1 1 180px;">

        <h3>NHL</h3>
        <p>Hockey</p>
        <button type="button">View Teams</button>

    </div>

</div>


<h2 style="color:#172554;
           margin-top:40px;
           margin-bottom:20px;">
    Team Standings
</h2>
<div style="margin-top:15px;
            margin-bottom:20px;
            display:flex;
            align-items:center;
            gap:15px;">

    <label for="leagueSelect"
           style="font-size:18px;
                  font-weight:bold;
                  color:#172554;">
        Select League:
    </label>

    <select id="leagueSelect"
            name="leagueSelect"
            style="padding:10px 15px;
                   border:1px solid #cbd5e1;
                   border-radius:8px;
                   background-color:#f1f5f9;
                   font-size:16px;
                   cursor:pointer;">

        <option value="NFL">NFL</option>
        <option value="NBA">NBA</option>
        <option value="MLB">MLB</option>
        <option value="NHL">NHL</option>

    </select>

</div>


<div style="background-color:#f1f5f9;
            padding:25px;
            border-radius:10px;
            margin-bottom:30px;">

    <table id="standingsTable"
           style="width:100%;
              border-collapse:collapse;
              text-align:left;">

        <thead>
            <tr style="background-color:#172554;
                       color:white;">

                <th style="padding:12px;">Team</th>
                <th style="padding:12px;">Wins</th>
                <th style="padding:12px;">Losses</th>
                <th style="padding:12px;">Win %</th>

            </tr>
        </thead>

        <tbody id="standingsBody">

            <tr style="background-color:white;">
                <td style="padding:12px;">Detroit Lions</td>
                <td style="padding:12px;">7</td>
                <td style="padding:12px;">2</td>
                <td style="padding:12px;">77.8%</td>
            </tr>

            <tr style="background-color:#e2e8f0;">
                <td style="padding:12px;">Green Bay Packers</td>
                <td style="padding:12px;">6</td>
                <td style="padding:12px;">4</td>
                <td style="padding:12px;">60.0%</td>
            </tr>

            <tr style="background-color:white;">
                <td style="padding:12px;">Chicago Bears</td>
                <td style="padding:12px;">5</td>
                <td style="padding:12px;">4</td>
                <td style="padding:12px;">55.6%</td>
            </tr>

        </tbody>

    </table>

</div>


<script>

    // Sample standings for each league
    const standings = {

        NFL: [
            ["Detroit Lions", 7, 2],
            ["Green Bay Packers", 6, 4],
            ["Chicago Bears", 5, 4]
        ],

        NBA: [
            ["Boston Celtics", 8, 2],
            ["Los Angeles Lakers", 7, 3],
            ["Chicago Bulls", 5, 5]
        ],

        MLB: [
            ["New York Yankees", 90, 72],
            ["Los Angeles Dodgers", 95, 67],
            ["Detroit Tigers", 85, 77]
        ],

        NHL: [
            ["Detroit Red Wings", 10, 5],
            ["Toronto Maple Leafs", 9, 6],
            ["Boston Bruins", 8, 7]
        ]

    };

    // Find the dropdown and table body
    const leagueSelect = document.getElementById("leagueSelect");

    const standingsBody = document.getElementById("standingsBody");

    // Update the standings table
    function updateStandings() {

        const selectedLeague = leagueSelect.value;

        const teams = standings[selectedLeague];

        // Clear existing rows
        standingsBody.innerHTML = "";

        // Add rows for the selected league
        teams.forEach((team, index) => {

            const wins = team[1];
            const losses = team[2];

            const winPercentage =
                ((wins / (wins + losses)) * 100).toFixed(1);

            const row = document.createElement("tr");

            row.style.backgroundColor =
                index % 2 === 0 ? "white" : "#e2e8f0";

            row.innerHTML = `
                <td style="padding:12px;">${team[0]}</td>
                <td style="padding:12px;">${wins}</td>
                <td style="padding:12px;">${losses}</td>
                <td style="padding:12px;">${winPercentage}%</td>
            `;

            standingsBody.appendChild(row);

        });

    }

    // Run whenever the selected league changes
    leagueSelect.addEventListener("change", updateStandings);

    // Display the selected league when the page loads
    updateStandings();

</script>