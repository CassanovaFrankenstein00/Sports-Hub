@{
    ViewData["Title"] = "Home Page";
}

<div style="background-color:#172554;
            color:white;
            padding:40px;
            border-radius:12px;
            margin-top:20px;">

    <h1 style="font-size:36px;
               font-weight:bold;">
        All Your Teams in One Place
    </h1>

    <p style="font-size:18px;">
        Browse teams, explore leagues, and view standings
        across your favorite sports.
    </p>

    <button type="button"
            style="background-color:#2563eb;
                   color:white;
                   padding:12px 25px;
                   border:none;
                   border-radius:8px;
                   margin-top:15px;">
        Browse Teams
    </button>

</div>
